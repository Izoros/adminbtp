{
  "name": "adminbtp",
  "private": true,
  "version": "0.1.0",
  "description": "AdminBTP — Plateforme SaaS de gestion administrative et opérationnelle pour le BTP (Mayotte / France)",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @adminbtp/web dev",
    "build": "pnpm --filter @adminbtp/web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
