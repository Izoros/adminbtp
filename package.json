{
  "name": "adminbtp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm run test --workspace web",
    "verify:guards": "npm run test --workspace web -- src/lib/permissions/server-guards.test.ts src/lib/permissions/server-scope.test.ts src/modules/documents/tests/document-actions.test.ts src/modules/signatures/tests/signature-actions.test.ts src/modules/consulting/tests/consulting-actions.test.ts src/modules/client-space/tests/client-space-actions.test.ts",
    "test:watch": "npm run test:watch --workspace web",
    "verify": "bash ./scripts/validate.sh",
    "verify:prod": "bash ./scripts/verify-production.sh",
    "audit:prod": "npm audit --omit=dev",
    "supabase:create-platform-admin": "node ./scripts/create-platform-admin.mjs",
    "supabase:set-user-password": "node ./scripts/set-user-password.mjs",
    "supabase:check": "bash ./scripts/check-supabase-prereqs.sh",
    "supabase:bootstrap": "bash ./scripts/bootstrap-supabase.sh",
    "supabase:init": "npx supabase init",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:lint": "npx supabase db lint",
    "supabase:verify-migrations": "bash ./scripts/verify-supabase-migrations.sh",
    "supabase:types": "npx supabase gen types typescript --local --schema public > apps/web/src/types/supabase.ts"
  },
  "devDependencies": {
    "supabase": "^2.101.0"
  }
}
